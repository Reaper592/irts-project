{
  "name": "irts-suite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "IRTS Suite — ERP multi-entites pour Maree Sonore, MSR (Maree Sonore Rental) et Owlaris",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "serve": "npm run build && node server/index.js",
    "preview": "vite preview",
    "lint": "oxlint src server",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
